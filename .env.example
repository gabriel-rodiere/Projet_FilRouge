# Copier ce fichier en .env puis remplir les valeurs. Le fichier .env n'est JAMAIS commité.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<ta-ressource>.openai.azure.com
AZURE_OPENAI_API_KEY=<ta-cle-api>
# Noms des DÉPLOIEMENTS (pas des modèles) : un modèle de chat et un modèle d'embeddings
CHAT_DEPLOYMENT=gpt-5.4-mini-2
EMBEDDING_DEPLOYMENT=embeddings
# env (clé du .env) | entra (aucune clé, Entra ID)
MODE_AUTH=env

# --- Réglages du modèle ---
MAX_TOKENS=800
TEMPERATURE=0.2
# Nombre de messages conservés dans l'historique de conversation
HISTORIQUE_MAX_MESSAGES=20

# --- MySQL : l'utilisateur en LECTURE SEULE créé par sql/00_mysql_base_et_utilisateur.sql ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=agent_ia
MYSQL_PASSWORD=<mot-de-passe-agent_ia>
MYSQL_DATABASE=catalogue

# --- RAG ---
# Répertoire des fiches PDF à indexer
FICHES_DIR=fiches_fournisseurs
# Répertoire du cache de l'index (non commité)
RAG_CACHE_DIR=cache

# --- Logs ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/assistant.jsonl

# --- Coûts : prix pour 1 million de tokens (VALEURS D'EXEMPLE, à remplacer par la grille Azure) ---
PRIX_ENTREE_1M_TOKENS=1.00
PRIX_SORTIE_1M_TOKENS=4.00
PRIX_EMBEDDING_1M_TOKENS=0.13
